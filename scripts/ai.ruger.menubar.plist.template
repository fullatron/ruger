<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The menu bar app. Built by scripts/build-menubar.sh; this keeps it running.
     __REPO__ is substituted by scripts/install-agents.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.ruger.menubar</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/build/RugerBar</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.pkm/logs/menubar.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.pkm/logs/menubar.log</string>

  <!-- Interactive: it draws a popover you are looking at, so it must not be
       I/O throttled the way a background tick can be. -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
